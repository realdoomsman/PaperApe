# PaperApe Environment

# ─── Web app (Next.js) ──────────────────────────────────
# Required in production. Local development defaults to http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase client config used by apps/web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── API server ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
MOCK_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,https://paperape.vercel.app,https://paper-ape.vercel.app,https://paperape.com,https://www.paperape.com,https://paperape.fun,https://www.paperape.fun

# Firebase Admin. Required when MOCK_MODE is not true.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Premium APIs.
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Optional Redis cache and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Chrome extension ───────────────────────────────────
# The extension reads these from chrome.storage.local when overridden:
# api_base=https://paperape-api.onrender.com
# webapp_url=https://paperape.fun
