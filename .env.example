# ═══════════════════════════════════════════════
# PaperApe API — Environment Variables
# ═══════════════════════════════════════════════

# ─── Server ──────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://paperape.vercel.app,https://paperape.com,https://www.paperape.com,http://localhost:3000

# ─── Firebase Admin ──────────────────────────
FIREBASE_PROJECT_ID="paperape"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@paperape.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ─── Premium APIs (PAID) ─────────────────────
# Helius — Fastest Solana RPC + DAS API ($49/mo Developer plan)
# Sign up: https://dev.helius.xyz
HELIUS_API_KEY=

# Birdeye Pro — Premium token analytics ($49/mo Starter plan)
# Sign up: https://birdeye.so/api
BIRDEYE_API_KEY=

# ─── Caching (PAID) ─────────────────────────
# Upstash Redis — Sub-ms caching + rate limiting ($0.2/100K ops)
# Sign up: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
